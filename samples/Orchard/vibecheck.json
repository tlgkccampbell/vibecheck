{
  "version": 0,
  "solution": "Orchard.slnx",
  "exclude": ["System.**"],
  "tests": ["Orchard.Tests::**"],
  "nodes": {
    "auth": { "name": "Auth", "purpose": "Identity, sessions and authorization decisions.", "category": "domain" },
    "auth.sessions": { "name": "Sessions", "purpose": "Session lookup and scope checks.", "bind": ["Orchard.Auth.Sessions.**"] },
    "auth.tokens": { "name": "Tokens", "purpose": "Bearer token issuance.", "bind": ["Orchard.Auth.Tokens.**"] },
    "billing": { "name": "Billing", "purpose": "Owns invoices, payments and the ledger.", "category": "domain" },
    "billing.api": { "name": "API", "purpose": "Billing endpoints.", "category": "entry", "bind": ["Orchard.Billing.Api.**"] },
    "billing.core": { "name": "Core", "purpose": "Payment orchestration and invoicing." },
    "billing.core.invoices": { "name": "Invoices", "purpose": "Invoice numbering and ledger postings.", "bind": ["Orchard.Billing.Core.Invoices.**"] },
    "billing.core.payments": { "name": "Payments", "purpose": "Capture of card payments.", "bind": ["Orchard.Billing.Core.Payments.**"] },
    "billing.core.self": { "name": "Payment service", "purpose": "The orchestrating service, declared directly in Core.", "bind": ["Orchard.Billing.Core.*"] },
    "billing.integrations": { "name": "Integrations", "purpose": "Adapters to payment providers.", "category": "integration" },
    "billing.integrations.stripe": { "name": "Stripe", "purpose": "Stand-in for the Stripe SDK, with its generated serializer context.", "bind": ["Orchard.Billing.Integrations.Stripe.**"] },
    "billing.ledger": { "name": "Ledger", "purpose": "Double-entry ledger, including the invoice record.", "bind": ["Orchard.Billing.Ledger.**"] },
    "notifications": { "name": "Notifications", "purpose": "Outbound messages raised by events.", "category": "integration" },
    "notifications.dispatch": { "name": "Dispatch", "purpose": "Routes events to the bus.", "bind": ["Orchard.Notifications.Dispatch.**"] },
    "notifications.templates": { "name": "Templates", "purpose": "Message templates per event.", "bind": ["Orchard.Notifications.Templates.**"] },
    "shared": { "name": "Shared", "purpose": "Primitives with no business meaning.", "category": "foundation" },
    "shared.kernel": { "name": "Kernel", "purpose": "Result type, identifiers and the map attribute.", "bind": ["Vibecheck.VibecheckAttribute", "Orchard.Shared.Kernel.**"] },
    "shared.messaging": { "name": "Messaging", "purpose": "In-process event bus.", "bind": ["Orchard.Shared.Messaging.**"] }
  },
  "views": {
    "by-concern": { "name": "By concern", "purpose": "The same leaves grouped by what they are for rather than by who owns them.", "level": "root", "groups": {
      "money": { "name": "Money", "purpose": "Everything that moves or records money.", "leaves": ["billing.core.invoices", "billing.core.payments", "billing.core.self", "billing.integrations.stripe", "billing.ledger"] },
      "plumbing": { "name": "Plumbing", "purpose": "Primitives, messaging and outbound notifications.", "leaves": ["notifications.dispatch", "notifications.templates", "shared.kernel", "shared.messaging"] },
      "requests": { "name": "Requests", "purpose": "Where requests arrive and identities are checked.", "leaves": ["auth.sessions", "auth.tokens", "billing.api"] }
    } }
  },
  "externals": {
    "bcl": { "name": "Base class library", "purpose": "Framework assemblies other than the core library.", "bind": ["System.*"] },
    "json": { "name": "System.Text.Json", "bind": ["System.Text.Json"] }
  }
}
