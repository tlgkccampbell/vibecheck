<?xml version="1.0" encoding="utf-8"?>
<!-- Installs the archmap tool from the local nupkg folder. It is named so that restores never load it on their own,
     and its own mapping keeps user-level package source mapping from refusing the local source. -->
<configuration>
  <packageSources>
    <clear />
    <add key="archmap-local" value="nupkg" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="archmap-local">
      <package pattern="archmap" />
    </packageSource>
  </packageSourceMapping>
</configuration>
