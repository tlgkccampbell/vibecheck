{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archviz.dev/schema/vibecheck.schema.json",
  "title": "Architecture map",
  "description": "The checked-in description of a system's nodes, bindings, views and exclusions. See docs/vibecheck-spec.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "solution", "exclude", "nodes", "views", "externals"],
  "properties": {
    "version": { "const": 0 },
    "solution": { "type": "string", "description": "The solution file, relative to the repository root." },
    "exclude": { "type": "array", "items": { "type": "string" }, "description": "Type patterns naming the types that are not part of the system. An excluded type is not partitioned and creates no edges." },
    "nodes": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/node" }
    },
    "views": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/segment" },
      "additionalProperties": { "$ref": "#/$defs/view" }
    },
    "externals": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/segment" },
      "additionalProperties": { "$ref": "#/$defs/external" }
    }
  },
  "$defs": {
    "segment": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "identifier": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)*$" },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "purpose": { "type": "string" },
        "category": { "enum": ["entry", "feature", "domain", "analysis", "transform", "integration", "foundation", "tooling"], "description": "The broad category of the node's role. A node without one takes its nearest ancestor's." },
        "note": { "type": "string" },
        "bind": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Patterns over fully qualified type names, with * (no dots) and ** (any) wildcards and an optional Assembly:: qualifier. Present on leaves only." }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "level", "groups"],
      "properties": {
        "name": { "type": "string" },
        "purpose": { "type": "string" },
        "level": { "type": "string", "description": "root or a container identifier. The view's groups partition the leaves under it." },
        "groups": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/segment" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "leaves"],
            "properties": {
              "name": { "type": "string" },
              "purpose": { "type": "string" },
              "leaves": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" } }
            }
          }
        }
      }
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bind"],
      "properties": {
        "name": { "type": "string" },
        "purpose": { "type": "string" },
        "bind": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Assembly name patterns, with * as a wildcard." }
      }
    }
  }
}
