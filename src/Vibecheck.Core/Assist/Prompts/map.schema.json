{
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes", "views"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "purpose"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "purpose": { "type": "string" },
          "category": { "type": "string", "enum": ["entry", "feature", "domain", "analysis", "transform", "integration", "foundation", "tooling"] },
          "bind": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "purpose", "level", "groups"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "purpose": { "type": "string" },
          "level": { "type": "string" },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "leaves"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "purpose": { "type": "string" },
                "leaves": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
